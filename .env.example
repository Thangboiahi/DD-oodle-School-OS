# DD-oodle School OS — Environment Variable Placeholders
# Copy this file to .env.local for local development once Supabase is configured.
# NEVER commit .env.local or any file containing real keys, tokens, or credentials.

# Public application URL & base domain (safe for client/server)
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_DOMAIN=dd-oodle.com

# Supabase project connection (safe for client/server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only privileged credentials (NEVER prefix with NEXT_PUBLIC_ or expose to browser)
SUPABASE_SECRET_KEY=
DATABASE_URL=
